// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model News {
  id          Int      @id @default(autoincrement())
  player      String   // Nombre del jugador
  flag        String   // injured, doubtful, risk, fit, boost
  title       String   // Titular de la noticia
  summary     String?  // Resumen generado por IA
  url         String   @unique // Enlace original (único para no duplicar)
  source      String   // Marca, AS, Relevo, etc.
  createdAt   DateTime @default(now())
  publishedAt DateTime @default(now())
}
